@using MYAcademy_IdentityEmail.Entities
@model Message

@{
    ViewData["Title"] = "Yeni Mesaj";
    Layout = "~/Views/MessageLayout/Index.cshtml";
}

<style>
    .compose-panel {
        padding: 0;
        overflow: hidden;
    }

    .compose-field {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .85rem 1.25rem;
        border-bottom: 1px solid rgba(0, 0, 0, .07);
        transition: background-color .15s ease;
    }

        .compose-field:focus-within {
            background-color: rgba(13, 110, 253, .03);
        }

        .compose-field label {
            flex: 0 0 64px;
            margin: 0;
            font-size: .875rem;
            font-weight: 500;
            color: #6c757d;
        }

        .compose-field input {
            flex: 1;
            border: 0;
            outline: 0;
            background: transparent;
            font-size: .95rem;
            color: inherit;
            min-width: 0;
        }

            .compose-field input::placeholder,
            .compose-body textarea::placeholder {
                color: #adb5bd;
            }

        .compose-field .field-icon {
            color: #adb5bd;
            font-size: 1rem;
        }

    .compose-from {
        font-size: .95rem;
        color: #495057;
    }

    .compose-body {
        padding: 1rem 1.25rem .5rem;
    }

        .compose-body textarea {
            width: 100%;
            min-height: 320px;
            border: 0;
            outline: 0;
            resize: vertical;
            background: transparent;
            font-size: .95rem;
            line-height: 1.65;
            color: inherit;
        }

    .compose-error {
        display: block;
        padding: 0 1.25rem .5rem calc(1.25rem + 64px + .75rem);
        font-size: .8rem;
        color: #dc3545;
    }

        .compose-error:empty {
            display: none;
        }

    .compose-actions {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .85rem 1.25rem;
        border-top: 1px solid rgba(0, 0, 0, .07);
        background: rgba(0, 0, 0, .015);
    }

    .compose-send {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .55rem 1.25rem;
        border-radius: 999px;
        font-weight: 500;
    }

        .compose-send .spinner-border {
            width: 1rem;
            height: 1rem;
            border-width: .15em;
        }

    .compose-hint {
        margin-left: auto;
        font-size: .8rem;
        color: #adb5bd;
    }

        .compose-hint kbd {
            font-size: .7rem;
            padding: .1rem .35rem;
            background: #f1f3f5;
            color: #6c757d;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            box-shadow: none;
        }

    .compose-counter {
        font-size: .8rem;
        color: #adb5bd;
        font-variant-numeric: tabular-nums;
    }

    @@media (max-width: 575.98px) {
        .compose-field label {
            flex-basis: 48px;
        }

        .compose-error {
            padding-left: 1.25rem;
        }

        .compose-hint {
            display: none;
        }
    }
</style>

<main class="inbox-container">

    <div class="inbox-header">
        <div>
            <h1 class="inbox-title">Yeni Mesaj</h1>
            <p class="inbox-subtitle">Alıcıyı, konuyu ve mesajınızı yazıp gönderin.</p>
        </div>
        <a asp-action="Sendbox" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-send me-1"></i>Giden Kutusu
        </a>
    </div>

    <form asp-action="CreateMessage" method="post" id="composeForm" autocomplete="off">
        <section class="inbox-panel compose-panel">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger m-3 mb-0"></div>

            <!-- Gönderen (sunucu tarafında giriş yapan kullanıcıdan alınır) -->
            <div class="compose-field">
                <label>Kimden</label>
                <span class="compose-from">@(User.Identity?.Name ?? "—")</span>
            </div>

            <!-- Alıcı -->
            <div class="compose-field">
                <label asp-for="ReceiverEmail">Kime</label>
                <input asp-for="ReceiverEmail" type="email" required
                       placeholder="ornek@mail.com"
                       aria-label="Alıcı e-posta adresi" autofocus>
                <i class="bi bi-person field-icon"></i>
            </div>
            <span asp-validation-for="ReceiverEmail" class="compose-error"></span>

            <!-- Konu -->
            <div class="compose-field">
                <label asp-for="Subject">Konu</label>
                <input asp-for="Subject" type="text" required maxlength="200"
                       placeholder="Mesajın konusu"
                       aria-label="Konu">
            </div>
            <span asp-validation-for="Subject" class="compose-error"></span>

            <!-- Mesaj -->
            <div class="compose-body">
                <textarea asp-for="MessageDetail" required maxlength="5000"
                          placeholder="Mesajınızı yazın…"
                          aria-label="Mesaj içeriği"></textarea>
            </div>
            <span asp-validation-for="MessageDetail" class="compose-error"></span>

            <!-- İşlemler -->
            <div class="compose-actions">
                <button type="submit" class="btn btn-primary compose-send" id="sendBtn">
                    <i class="bi bi-send-fill"></i>
                    <span>Gönder</span>
                </button>

                <a asp-action="Inbox" class="icon-btn" id="discardBtn"
                   data-bs-toggle="tooltip" data-bs-title="Vazgeç" aria-label="Vazgeç">
                    <i class="bi bi-trash3"></i>
                </a>

                <span class="compose-counter ms-2" id="charCounter">0 / 5000</span>

                <span class="compose-hint">
                    <kbd>Ctrl</kbd> + <kbd>Enter</kbd> ile gönder
                </span>
            </div>
        </section>
    </form>
</main>

<script>
    (function () {
        const form = document.getElementById('composeForm');
        const sendBtn = document.getElementById('sendBtn');
        const textarea = form.querySelector('textarea');
        const counter = document.getElementById('charCounter');
        const discardBtn = document.getElementById('discardBtn');
        let submitting = false;

        // Karakter sayacı
        const updateCounter = () => {
            counter.textContent = `${textarea.value.length} / ${textarea.maxLength}`;
        };
        textarea.addEventListener('input', updateCounter);
        updateCounter();

        // Ctrl/Cmd + Enter ile gönder
        form.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault();
                form.requestSubmit();
            }
        });

        // Çift gönderimi engelle
        form.addEventListener('submit', (e) => {
            if (!form.checkValidity()) return;
            if (submitting) { e.preventDefault(); return; }
            submitting = true;
            sendBtn.disabled = true;
            sendBtn.innerHTML = '<span class="spinner-border" role="status" aria-hidden="true"></span><span>Gönderiliyor…</span>';
        });

        // Yazılmış bir taslak varken vazgeçerken onay iste
        const isDirty = () =>
            [...form.querySelectorAll('input[type=email], input[type=text], textarea')]
                .some(el => el.value.trim() !== '');

        discardBtn.addEventListener('click', (e) => {
            if (isDirty() && !confirm('Yazdığınız mesaj silinecek. Emin misiniz?')) {
                e.preventDefault();
                return;
            }
            submitting = true; // onaylandı, sayfadan çıkış uyarısını atla
        });

        // Kaydedilmemiş taslakla sayfadan çıkarken tarayıcı uyarısı
        window.addEventListener('beforeunload', (e) => {
            if (!submitting && isDirty()) e.preventDefault();
        });

        // Bootstrap tooltip'leri
        if (window.bootstrap?.Tooltip) {
            form.querySelectorAll('[data-bs-toggle="tooltip"]')
                .forEach(el => new bootstrap.Tooltip(el));
        }
    })();
</script>